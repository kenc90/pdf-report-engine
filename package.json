{
  "name": "pdf-report-engine",
  "version": "0.1.0",
  "description": "Real (vector, searchable-text) paginated PDF report engine: report IR -> layout -> pagination -> PDF. Pure JS, no Chromium.",
  "type": "module",
  "license": "MIT",
  "author": "kenc90",
  "homepage": "https://kenc90.github.io/pdf-report-engine/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenc90/pdf-report-engine.git"
  },
  "bugs": {
    "url": "https://github.com/kenc90/pdf-report-engine/issues"
  },
  "keywords": [
    "pdf",
    "report",
    "pagination",
    "jasper",
    "layout-engine",
    "text-shaping"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx src/cli/demo.ts",
    "html:pdf": "tsx src/cli/html-to-pdf.ts",
    "docs": "node scripts/serve-site.mjs",
    "build:browser": "esbuild src/index.ts --bundle --platform=browser --format=esm --target=es2020 --alias:pdfkit=./node_modules/pdfkit/js/pdfkit.standalone.js --external:node:fs/promises --external:fs --external:path --minify --outfile=docs/browser/pdf-report-engine.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fontkit": "^2.0.2",
    "pdfkit": "^0.16.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.7",
    "@types/node": "^20.14.0",
    "@types/pdfkit": "^0.13.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
